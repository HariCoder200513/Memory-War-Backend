# ──────────────────────────────────────────────
# Memory Wars Backend — Environment Configuration
# ──────────────────────────────────────────────
# Copy to .env and fill in your values.

PORT=8080
DATABASE_URL=postgres://postgres:postgres@localhost:5432/memory_wars?sslmode=disable
JWT_SECRET=change-me-in-production
JWT_EXPIRY=15m
REFRESH_EXPIRY=168h
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@memorywars.com
FRONTEND_BASE_URL=http://localhost:3000
ENVIRONMENT=development
